  "people": {
    "linya": {
      "name": "林芽",
      "role": "收集种子的人",
      "about": "希望恢复农业贸易，却担心年轻人沿恢复的运输线继续离开。她保留每一张尚未兑现的订单。",
      "place": "白天在农场种子摊；傍晚在村庄广场或茶座"
    },
    "zhou": {
      "name": "周砚",
      "role": "河湾村的木匠",
      "about": "父亲在旧桥事故前叫停了重车。他想证明父亲的检查与护送没有白做，也逐渐学会请邻居一起承担。",
      "place": "白天在木作坊；修桥期间与建成后会在桥边；傍晚在茶座"
    },
    "ahe": {
      "name": "阿禾",
      "role": "茶屋的主人",
      "about": "保管茶屋留言册，把借桶、带菜和回执夹在一起。她相信信任需要每天能用得上的公共生活。",
      "place": "白天在茶屋；水井建成后午间到井边；傍晚在茶座"
    }
  },
  "scenes": {
    "letter": {
      "title": "序幕 · 旧屋里的信",
      "stage": 0,
      "next": 1,
      "lines": [
        {
          "who": "姨婆的信",
          "portrait": "letter",
          "text": "窗台下面那只木盒，钥匙还插着。先种点东西吃，河边的事不用急。"
        },
        {
          "who": "姨婆的信",
          "portrait": "letter",
          "text": "我一直没寄出这封信。旧桥停运那天，货单上划掉了一个名字；后来，大家只记得桥断了。"
        },
        {
          "who": "姨婆的信",
          "portrait": "letter",
          "text": "附着的半张地图缺了东岸。西岸画着一枚扳手，旁边写：不是所有离开的人，都不想回来。"
        }
      ],
      "choices": [
        {
          "id": "renew",
          "text": "先把地种好，再找地图的另一半。",
          "reply": "你把信折回木盒，留下一角露在窗光里。"
        },
        {
          "id": "home",
          "text": "先认识留下来的人。",
          "reply": "你记下三个名字：林芽、周砚、阿禾。"
        }
      ]
    },
    "welcome": {
      "title": "留下的种子，离开的车",
      "stage": 1,
      "next": 2,
      "lines": [
        {
          "who": "林芽",
          "portrait": "linya",
          "text": "种子还在。以前每天有车来收菜，我总嫌车铃吵。"
        },
        {
          "who": "林芽",
          "portrait": "linya",
          "text": "现在摊位旁很安静。我想把贸易接回来，又怕路一通，年轻人就都走了。"
        },
        {
          "who": "林芽",
          "portrait": "linya",
          "text": "先种一次、浇一次水，再收一份自己的作物吧。三个胡萝卜，我替茶屋收。地图的扳手记号，在旧桥西边。"
        }
      ]
    },
    "harvest": {
      "title": "第一声车铃",
      "stage": 2,
      "next": 3,
      "requirements": {
        "carrot": 3
      },
      "coins": 50,
      "lines": [
        {
          "who": "林芽",
          "portrait": "linya",
          "text": "泥还没抖干净呢。阿禾就喜欢这样的菜。这里是五十金。"
        },
        {
          "who": "林芽",
          "portrait": "linya",
          "text": "你问那个被划掉的名字？我只见过装空箱子离开的车，没人肯说那天装过什么。"
        },
        {
          "who": "林芽",
          "portrait": "linya",
          "text": "北面旧桥有新的量水刻度，木作坊旁还压着旧维修记录。先看看，再找周砚。他不喜欢别人只问：什么时候修好。"
        }
      ],
      "requires_facts": [
        "plant",
        "water",
        "harvest"
      ]
    },
    "carpenter": {
      "title": "第一幕 · 不愿修桥的人",
      "stage": 3,
      "next": 4,
      "lines": [
        {
          "who": "周砚",
          "portrait": "zhou",
          "text": "……你看过记录了？那行停运建议，是我父亲写的。"
        },
        {
          "who": "周砚",
          "portrait": "zhou",
          "text": "桥还撑着的时候，他先拦下最后一辆货车。后来桥塌了，大家记住的是“周家的桥”。"
        },
        {
          "who": "周砚",
          "portrait": "zhou",
          "text": "我不想修一座只为证明他没错的桥。得有人愿意走，也有人愿意负责。阿禾的留言册里，还夹着当年的回执。"
        }
      ],
      "requires_facts": [
        "bridge_survey",
        "repair_record"
      ]
    },
    "bridge": {
      "title": "把名字留在桥上",
      "stage": 4,
      "next": 5,
      "requirements": {
        "wood": 8,
        "stone": 6
      },
      "lines": [
        {
          "who": "周砚",
          "portrait": "zhou",
          "text": "留言册里还有他的签名……原来那天有人给他送过饭。"
        },
        {
          "who": "周砚",
          "portrait": "zhou",
          "text": "八份木材、六份石料，够把桥脚垫高。旧水位线留下，新的每年再刻。"
        },
        {
          "who": "周砚",
          "portrait": "zhou",
          "text": "你扶住这边。我们给桥留一道能换的接缝，也给后来的人留下一本能查的记录。"
        },
        {
          "who": "周砚",
          "portrait": "zhou",
          "text": "东岸风车的货运簿还在。过去人们把名字写在那里，现在我们去把它读全。"
        }
      ],
      "requires_facts": [
        "bridge_survey",
        "repair_record",
        "guestbook"
      ]
    },
    "mill": {
      "title": "第三幕 · 风车下的记录",
      "stage": 5,
      "next": 6,
      "lines": [
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "货运簿最后一页粘在木桌上。那天运出的不是货，是东岸三户人的行李。收货人一栏写着：由周衡护送。"
        },
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "林芽的订单写在下一页，没有划掉。她一直留着可以重新装车的位置。"
        },
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "地图缺失的那一半，原来是货单背面的河岸。你将它拼好：风车、井、共仓和茶座，被一条步行的小路连在一起。"
        },
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "夹页里有两张便条。可以在风车旁的货箱继续查看，再到共建板决定先修哪一处。"
        }
      ],
      "requires_facts": [
        "guestbook",
        "east_bank"
      ]
    },
    "supper": {
      "title": "能借一只桶的邻居",
      "stage": 6,
      "next": 7,
      "lines": [
        {
          "who": "阿禾",
          "portrait": "ahe",
          "text": "今天有人把桶放回井边，没署名。我看见周砚把桶底补好了，也没署名。"
        },
        {
          "who": "阿禾",
          "portrait": "ahe",
          "text": "林芽在共仓多挂了一块牌：留下的种子写名字，带走的种子写去处。茶座上已经有人约好明天来换苗。"
        },
        {
          "who": "阿禾",
          "portrait": "ahe",
          "text": "留言册这页不写谁欠谁，只写谁愿意再来。傍晚六点，把旧桥那头的灯也点起来吧。"
        }
      ]
    },
    "festival": {
      "title": "终幕 · 风灯照亮的路",
      "stage": 7,
      "next": 8,
      "coins": 120,
      "lines": [
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "桥边的灯一路亮到风车。有人在共仓写下订单，有人在茶座摊开地图。那几个被水打湿的名字，第一次并排挂在灯下。"
        },
        {
          "who": "周砚",
          "portrait": "zhou",
          "text": "我把父亲的名字刻在检查簿上了。下一页，签我们自己的。"
        },
        {
          "who": "林芽",
          "portrait": "linya",
          "text": "路通了，还是会有人走。我想试试，让这里也成为值得回来做生意的地方。"
        },
        {
          "who": "阿禾",
          "portrait": "ahe",
          "text": "留言册还有空页。先从哪件事开始？别的事，我们以后也一起做。"
        }
      ],
      "choices": [
        {
          "id": "trade",
          "text": "农业贸易 · 让收成重新上路",
          "reply": "林芽摊开第一张订货纸：先问清大家愿意种什么。你得到胡萝卜种子三袋。"
        },
        {
          "id": "explore",
          "text": "自然探索 · 沿河寻找新线索",
          "reply": "周砚给地图补上安全水位：先看看东岸的草木。你得到小麦种子六袋，作沿途补种。"
        },
        {
          "id": "life",
          "text": "居民生活 · 让每天好过一点",
          "reply": "阿禾留下茶座值日表的第一格：从彼此能开口的小事做起。你得到土豆种子三袋。"
        }
      ]
    },
    "bench": {
      "title": "等一等，也是一种生活",
      "lines": [
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "你在长椅上坐下。河水慢慢经过，茶屋飘来一点麦香。要在这里休息到今天 18:00 吗？"
        }
      ],
      "choices": [
        {
          "id": "wait",
          "text": "坐到傍晚（18:00）",
          "reply": "树影从鞋尖慢慢挪开。等你抬起头，茶屋已经点了灯。"
        },
        {
          "id": "leave",
          "text": "继续逛逛。",
          "reply": "长椅会一直在这里。你起身，拍掉衣角的一片叶子。"
        }
      ]
    },
    "well": {
      "title": "井边的刻痕",
      "lines": [
        {
          "who": "井边的小木牌",
          "portrait": "letter",
          "text": "井沿上有一排高矮不同的刻痕。最矮的一道写着“林芽，第一颗掉牙”。"
        },
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "后面的身高一年比一年高，字却一直歪歪扭扭。最后一行是：“今年已经比姨婆高啦。”"
        }
      ]
    },
    "ribbon": {
      "title": "没有剪短的蓝丝带",
      "lines": [
        {
          "who": "树下的丝带",
          "portrait": "letter",
          "text": "一条褪色的蓝丝带系在低处，末端打了个笨拙的结。旁边的小牌写着：“这里也要留给够不着的人。”"
        },
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "结的另一头是新换的。有人一直在照顾这个小小的约定。"
        }
      ]
    },
    "post": {
      "title": "一封寄回来的明信片",
      "lines": [
        {
          "who": "旧公告栏",
          "portrait": "letter",
          "text": "“阿禾：大城里的面包没有你做的软。我学会修电灯了，明年给你带一盏不会熄的回来。”"
        },
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "邮戳已经很旧，下面却添了新字：“灯收到了。下回记得把自己也带回来。”"
        }
      ]
    },
    "water_help": {
      "title": "清泉流向田野",
      "lines": [
        {
          "who": "井边的木牌",
          "portrait": "zhou",
          "text": "打开这只木闸，清水就会顺着修好的水沟送到农场。一天引水一次，已经开垦的土地都能浇到。"
        }
      ],
      "choices": [
        {
          "id": "draw",
          "text": "打开木闸，浇灌今天的农田。",
          "reply": "清水拐过桥边，朝农场流去。修好的井，正在照顾新的种子。"
        },
        {
          "id": "leave",
          "text": "先留着，等播种后再来。",
          "reply": "你重新扣好闸门。井边的水声，听起来很安稳。"
        }
      ]
    },
    "bridge_survey": {
      "title": "桥墩上的两条水线",
      "lines": [
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "旧钉孔齐齐排在低处，新量尺却高出一掌。断木上没有车轮痕，桥边留下半枚褪色的停运章。"
        },
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "你把两条水线抄在地图边：桥垮以前，运输线就已经停了。"
        }
      ]
    },
    "repair_record": {
      "title": "被雨泡开的维修记录",
      "lines": [
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "木作坊檐下的铁盒里，夹着一页账。补梁的费用被圈了三次，下面写着：先停重车，人行仍可过。"
        },
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "末尾签名：周衡。最后一次检查后，他把工具借给了东岸搬家的人。"
        }
      ]
    },
    "guestbook": {
      "title": "第二幕 · 茶屋里的留言册",
      "lines": [
        {
          "who": "阿禾",
          "portrait": "ahe",
          "text": "这一页不是账。车停了以后，谁替谁带菜、谁借给谁一只空箱子，我都记在这里。"
        },
        {
          "who": "阿禾",
          "portrait": "ahe",
          "text": "有人走，是因为药要去镇上拿；有人走，是不愿孩子每天绕远路。走之前都说过：等路好了。"
        },
        {
          "who": "阿禾",
          "portrait": "ahe",
          "text": "周衡那天没有收工钱，只在回执上写“人已平安到岸”。周砚还没见过这页。"
        },
        {
          "who": "阿禾",
          "portrait": "ahe",
          "text": "井绳坏了，大家轮流提水，却没人再愿意开口借桶。先让公共的东西好用起来，人才能慢慢坐回一张桌。"
        }
      ],
      "min_stage": 4
    },
    "cargo_note": {
      "title": "货箱里的回执",
      "lines": [
        {
          "who": "旁白",
          "portrait": "letter",
          "text": "货箱底部压着两张没有寄出的便条。"
        }
      ],
      "choices": [
        {
          "id": "ask_departure",
          "text": "看看离村的人写了什么。",
          "reply": "“阿禾，我不是不信你们。药不能等下一班车。等孩子好些，我会回来看看那座桥。”"
        },
        {
          "id": "ask_name",
          "text": "看看周衡留下的名字。",
          "reply": "“送三户人到岸，空箱留给林芽。运费先欠着，明年有菜再算。”最后一笔被水洇开，姓名仍清楚。"
        }
      ],
      "min_stage": 5
    },
    "review_letter": {
      "title": "回顾 · 那些没有寄出的信",
      "lines": [
        {
          "who": "姨婆的信",
          "portrait": "letter",
          "text": "旧木盒里的信，和你已经修好的桥，都保留着。新的线索不会让你再交一份旧材料。"
        },
        {
          "who": "姨婆的信",
          "portrait": "letter",
          "text": "地图的另一半在河东风车。桥墩的水线、木作坊的维修记录和茶屋留言册，把那次停运拼成了完整的一天。"
        },
        {
          "who": "姨婆的信",
          "portrait": "letter",
          "text": "你可以随时重访这些地点。到风灯架，还能商量村庄下一步的发展方向。"
        }
      ]
    },
    "future": {
      "title": "村庄下一页",
      "lines": [
        {
          "who": "阿禾",
          "portrait": "ahe",
          "text": "灯已经亮过了，日子还在往前。留言册为下一步留了一页空白。"
        }
      ],
      "choices": [
        {
          "id": "trade",
          "text": "农业贸易 · 让收成重新上路",
          "reply": "林芽摊开第一张订货纸：先问清大家愿意种什么。你得到胡萝卜种子三袋。"
        },
        {
          "id": "explore",
          "text": "自然探索 · 沿河寻找新线索",
          "reply": "周砚给地图补上安全水位：先看看东岸的草木。你得到小麦种子六袋，作沿途补种。"
        },
