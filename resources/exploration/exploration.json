  "entrances": {
    "forest_entry": {
      "area": "farm",
      "position": [
        208,
        320
      ],
      "title": "西北林径 · 迷雾森林",
      "destination": "mist_forest",
      "text": "一排旧木桩沿坡伸进树林。新增的林间空地生长着大量可再生树木，也有散布的石堆；带上斧头和镐就能采集。树皮上的四季叶纹仍指向更深处的采样架。"
    },
    "lake_entry": {
      "area": "farm",
      "position": [
        1296,
        688
      ],
      "title": "湖东旧阶 · 排水检修口",
      "destination": "lake_ruins",
      "text": "石阶通向一条封闭拱廊。这里不是潜水入口：先恢复湖泊循环，按森林档案核对排水刻度，旧检修廊才可安全开启。"
    },
    "temple_entry": {
      "area": "village",
      "position": [
        1200,
        688
      ],
      "title": "东岸石门 · 古老神庙",
      "destination": "old_temple",
      "text": "门柱把矿车、水闸和归航星标刻在一起。带上森林与排水廊的档案，并掌握晶石洞窟和星纹镐的工艺，才能读懂开门的定位线。"
    }
  },
